{
  "name": "three-ntc-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "tsc": "tsc -b",
    "dev": "pnpm --parallel --filter three-ntc --filter three-ntc-trainer --filter website dev",
    "test": "pnpm tsc && vitest run --project unit --coverage",
    "test:gpu": "vitest run --project gpu",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "test:gpu:safari": "NTC_BROWSER=safari vitest run --project gpu --fileParallelism=false",
    "profile:browser": "node scripts/profile-browsers.mjs",
    "prepare": "husky",
    "commitlint": "commitlint",
    "size": "node scripts/check-bundle-size.mjs",
    "release": "semantic-release",
    "release:check": "node --test scripts/release.test.mjs"
  },
  "devDependencies": {
    "@anolilab/semantic-release-pnpm": "^8.1.25",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.20.0",
    "@visulima/yaml": "^1.0.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/browser-webdriverio": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "playwright": "^1.63.0",
    "semantic-release": "^25.0.9",
    "three": "0.186.0",
    "typescript": "^5.7.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10",
    "webdriverio": "^9.31.7"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.1.3"
}

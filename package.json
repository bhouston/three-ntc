{
  "name": "three-ntc-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "tsc": "tsc -b",
    "dev": "pnpm --parallel --filter three-ntc --filter three-ntc-trainer --filter website dev",
    "test": "pnpm tsc && vitest run --project unit",
    "test:gpu": "vitest run --project gpu",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "make-release:three-ntc": "node scripts/make-release.mjs packages/three-ntc",
    "make-release:three-ntc-trainer": "node scripts/make-release.mjs packages/three-ntc-trainer"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@vitest/browser-playwright": "^4.1.11",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "playwright": "^1.63.0",
    "typescript": "^5.7.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.1.3"
}

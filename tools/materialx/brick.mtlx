<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="brick_color_graph">
    <texcoord name="texcoord1" type="vector2" />
    <separate2 name="uv_components" type="vector2">
      <input name="in" type="vector2" nodename="texcoord1" />
    </separate2>
    <multiply name="tiled_u" type="float">
      <input name="in1" type="float" nodename="uv_components" output="outx" />
      <input name="in2" type="float" value="6.0" />
    </multiply>
    <multiply name="tiled_v" type="float">
      <input name="in1" type="float" nodename="uv_components" output="outy" />
      <input name="in2" type="float" value="10.0" />
    </multiply>
    <floor name="row" type="float">
      <input name="in" type="float" nodename="tiled_v" />
    </floor>
    <modulo name="row_odd" type="float">
      <input name="in1" type="float" nodename="row" />
      <input name="in2" type="float" value="2.0" />
    </modulo>
    <multiply name="row_offset" type="float">
      <input name="in1" type="float" nodename="row_odd" />
      <input name="in2" type="float" value="0.5" />
    </multiply>
    <add name="shifted_u" type="float">
      <input name="in1" type="float" nodename="tiled_u" />
      <input name="in2" type="float" nodename="row_offset" />
    </add>
    <floor name="brick_col" type="float">
      <input name="in" type="float" nodename="shifted_u" />
    </floor>
    <fract name="brick_u" type="float">
      <input name="in" type="float" nodename="shifted_u" />
    </fract>
    <fract name="brick_v" type="float">
      <input name="in" type="float" nodename="tiled_v" />
    </fract>
    <subtract name="brick_u_inv" type="float">
      <input name="in1" type="float" value="1.0" />
      <input name="in2" type="float" nodename="brick_u" />
    </subtract>
    <subtract name="brick_v_inv" type="float">
      <input name="in1" type="float" value="1.0" />
      <input name="in2" type="float" nodename="brick_v" />
    </subtract>
    <min name="edge_dist_u" type="float">
      <input name="in1" type="float" nodename="brick_u" />
      <input name="in2" type="float" nodename="brick_u_inv" />
    </min>
    <min name="edge_dist_v" type="float">
      <input name="in1" type="float" nodename="brick_v" />
      <input name="in2" type="float" nodename="brick_v_inv" />
    </min>
    <min name="edge_dist" type="float">
      <input name="in1" type="float" nodename="edge_dist_u" />
      <input name="in2" type="float" nodename="edge_dist_v" />
    </min>
    <smoothstep name="mortar_mask" type="float">
      <input name="in" type="float" nodename="edge_dist" />
      <input name="low" type="float" value="0.025" />
      <input name="high" type="float" value="0.07" />
    </smoothstep>
    <combine2 name="brick_cell_id" type="vector2">
      <input name="in1" type="float" nodename="brick_col" />
      <input name="in2" type="float" nodename="row" />
    </combine2>
    <cellnoise2d name="brick_shade" type="float">
      <input name="texcoord" type="vector2" nodename="brick_cell_id" />
    </cellnoise2d>
    <mix name="brick_base_color" type="color3">
      <input name="bg" type="color3" value="0.62, 0.30, 0.13" />
      <input name="fg" type="color3" value="0.38, 0.10, 0.07" />
      <input name="mix" type="float" nodename="brick_shade" />
    </mix>
    <combine2 name="grain_uv" type="vector2">
      <input name="in1" type="float" nodename="tiled_u" />
      <input name="in2" type="float" nodename="tiled_v" />
    </combine2>
    <fractal2d name="grain_noise" type="float">
      <input name="texcoord" type="vector2" nodename="grain_uv" />
      <input name="octaves" type="integer" value="3" />
      <input name="lacunarity" type="float" value="2.0" />
      <input name="diminish" type="float" value="0.55" />
      <input name="amplitude" type="float" value="0.12" />
    </fractal2d>
    <add name="grain_factor" type="float">
      <input name="in1" type="float" nodename="grain_noise" />
      <input name="in2" type="float" value="1.0" />
    </add>
    <multiply name="brick_color" type="color3">
      <input name="in1" type="color3" nodename="brick_base_color" />
      <input name="in2" type="float" nodename="grain_factor" />
    </multiply>
    <mix name="final_color" type="color3">
      <input name="bg" type="color3" value="0.56, 0.53, 0.49" />
      <input name="fg" type="color3" nodename="brick_color" />
      <input name="mix" type="float" nodename="mortar_mask" />
    </mix>
    <output name="out" type="color3" nodename="final_color" />
  </nodegraph>
  <nodegraph name="brick_normal_graph">
    <texcoord name="texcoord1" type="vector2" />
    <separate2 name="uv_components" type="vector2">
      <input name="in" type="vector2" nodename="texcoord1" />
    </separate2>
    <multiply name="tiled_u" type="float">
      <input name="in1" type="float" nodename="uv_components" output="outx" />
      <input name="in2" type="float" value="6.0" />
    </multiply>
    <multiply name="tiled_v" type="float">
      <input name="in1" type="float" nodename="uv_components" output="outy" />
      <input name="in2" type="float" value="10.0" />
    </multiply>
    <floor name="row" type="float">
      <input name="in" type="float" nodename="tiled_v" />
    </floor>
    <modulo name="row_odd" type="float">
      <input name="in1" type="float" nodename="row" />
      <input name="in2" type="float" value="2.0" />
    </modulo>
    <multiply name="row_offset" type="float">
      <input name="in1" type="float" nodename="row_odd" />
      <input name="in2" type="float" value="0.5" />
    </multiply>
    <add name="shifted_u" type="float">
      <input name="in1" type="float" nodename="tiled_u" />
      <input name="in2" type="float" nodename="row_offset" />
    </add>
    <fract name="brick_u" type="float">
      <input name="in" type="float" nodename="shifted_u" />
    </fract>
    <fract name="brick_v" type="float">
      <input name="in" type="float" nodename="tiled_v" />
    </fract>
    <subtract name="brick_u_inv" type="float">
      <input name="in1" type="float" value="1.0" />
      <input name="in2" type="float" nodename="brick_u" />
    </subtract>
    <subtract name="brick_v_inv" type="float">
      <input name="in1" type="float" value="1.0" />
      <input name="in2" type="float" nodename="brick_v" />
    </subtract>
    <min name="edge_dist_u" type="float">
      <input name="in1" type="float" nodename="brick_u" />
      <input name="in2" type="float" nodename="brick_u_inv" />
    </min>
    <min name="edge_dist_v" type="float">
      <input name="in1" type="float" nodename="brick_v" />
      <input name="in2" type="float" nodename="brick_v_inv" />
    </min>
    <min name="edge_dist" type="float">
      <input name="in1" type="float" nodename="edge_dist_u" />
      <input name="in2" type="float" nodename="edge_dist_v" />
    </min>
    <smoothstep name="mortar_mask" type="float">
      <input name="in" type="float" nodename="edge_dist" />
      <input name="low" type="float" value="0.025" />
      <input name="high" type="float" value="0.07" />
    </smoothstep>
    <heighttonormal name="tangent_normal" type="vector3">
      <input name="in" type="float" nodename="mortar_mask" />
      <input name="scale" type="float" value="0.6" />
      <input name="texcoord" type="vector2" nodename="texcoord1" />
    </heighttonormal>
    <normalmap name="world_normal" type="vector3">
      <input name="in" type="vector3" nodename="tangent_normal" />
      <input name="scale" type="float" value="1.0" />
    </normalmap>
    <output name="out" type="vector3" nodename="world_normal" />
  </nodegraph>
  <standard_surface name="SR_brick" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="brick_color_graph" output="out" />
    <input name="specular" type="float" value="0.25" />
    <input name="specular_roughness" type="float" value="0.82" />
    <input name="metalness" type="float" value="0.0" />
    <input name="coat" type="float" value="0.0" />
    <input name="normal" type="vector3" nodegraph="brick_normal_graph" output="out" />
  </standard_surface>
  <surfacematerial name="M_brick" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_brick" />
  </surfacematerial>
</materialx>

<?xml version="1.0"?>
<materialx version="1.39">
  <surfacematerial name="mat_rotate_scale2d_test" type="material" nodedef="ND_surfacematerial">
    <input name="surfaceshader" type="surfaceshader" nodename="surface_shader1" />
  </surfacematerial>
  <standard_surface name="surface_shader1" type="surfaceshader" nodedef="ND_standard_surface_surfaceshader">
    <input name="base_color" type="color3" output="out" nodegraph="rotate_scale2d_test" />
  </standard_surface>
  <nodegraph name="rotate_scale2d_test">
    <!-- Evaluation order: texcoord -> rotate -> scale (non-uniform) -> image.
         Chained the opposite way from standard_surface_scale_rotate2d_test.mtlx
         so the two samples together exercise whether a UV-transform detector
         accumulates node order correctly - rotate-then-scale and scale-then-
         rotate are not the same transform when the scale is non-uniform. -->
    <texcoord name="texcoord1" type="vector2" />
    <rotate2d name="rotate2d_1" type="vector2">
      <input name="in" type="vector2" nodename="texcoord1" />
      <input name="amount" type="float" value="30.0" unittype="angle" unit="degree" />
    </rotate2d>
    <multiply name="scale2d_1" type="vector2">
      <input name="in1" type="vector2" nodename="rotate2d_1" />
      <input name="in2" type="vector2" value="3.0, 1.0" />
    </multiply>
    <image name="rotated_scaled_image" type="color3">
      <input name="file" type="filename" value="resources/Images/grid.png" />
      <input name="default" type="color3" value="0.5, 0.5, 0.5" />
      <input name="texcoord" type="vector2" nodename="scale2d_1" />
    </image>
    <output name="out" type="color3" nodename="rotated_scaled_image" />
  </nodegraph>
</materialx>

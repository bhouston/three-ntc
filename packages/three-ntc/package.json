  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhouston/three-ntc.git",
    "directory": "packages/three-ntc"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }

{
  "extends": "../../tsconfig.node.json",
  "include": ["**/*.ts", "**/*.tsx", "../../test/performance-metrics.ts"],
  "exclude": ["node_modules", "dist", ".output", ".nitro", ".tanstack"],
  "compilerOptions": {
    "composite": true,
    "rootDir": "../..",
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "references": [{ "path": "../three-ntc/tsconfig.build.json" }, { "path": "../three-ntc-trainer/tsconfig.build.json" }]
}

<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="road_color_graph">
    <texcoord name="texcoord1" type="vector2" />
    <separate2 name="uv_components" type="vector2">
      <input name="in" type="vector2" nodename="texcoord1" />
    </separate2>
    <multiply name="tiled_u" type="float">
      <input name="in1" type="float" nodename="uv_components" output="outx" />
      <input name="in2" type="float" value="9.0" />
    </multiply>
    <multiply name="tiled_v" type="float">
      <input name="in1" type="float" nodename="uv_components" output="outy" />
      <input name="in2" type="float" value="9.0" />
    </multiply>
    <combine2 name="tiled_uv" type="vector2">
      <input name="in1" type="float" nodename="tiled_u" />
      <input name="in2" type="float" nodename="tiled_v" />
    </combine2>
    <worleynoise2d name="cell_edges" type="float">
      <input name="texcoord" type="vector2" nodename="tiled_uv" />
      <input name="jitter" type="float" value="0.95" />
      <input name="style" type="integer" value="2" />
    </worleynoise2d>
    <smoothstep name="rock_mask" type="float">
      <input name="in" type="float" nodename="cell_edges" />
      <input name="low" type="float" value="0.04" />
      <input name="high" type="float" value="0.14" />
    </smoothstep>
    <cellnoise2d name="rock_id" type="float">
      <input name="texcoord" type="vector2" nodename="tiled_uv" />
    </cellnoise2d>
    <ifgreater name="rock_pick_hi" type="color3">
      <input name="value1" type="float" nodename="rock_id" />
      <input name="value2" type="float" value="0.75" />
      <input name="in1" type="color3" value="0.27, 0.27, 0.28" />
      <input name="in2" type="color3" value="0.44, 0.25, 0.17" />
    </ifgreater>
    <ifgreater name="rock_pick_mid" type="color3">
      <input name="value1" type="float" nodename="rock_id" />
      <input name="value2" type="float" value="0.5" />
      <input name="in1" type="color3" nodename="rock_pick_hi" />
      <input name="in2" type="color3" value="0.58, 0.50, 0.40" />
    </ifgreater>
    <ifgreater name="rock_color" type="color3">
      <input name="value1" type="float" nodename="rock_id" />
      <input name="value2" type="float" value="0.25" />
      <input name="in1" type="color3" nodename="rock_pick_mid" />
      <input name="in2" type="color3" value="0.50, 0.49, 0.47" />
    </ifgreater>
    <fractal2d name="grain_noise" type="float">
      <input name="texcoord" type="vector2" nodename="tiled_uv" />
      <input name="octaves" type="integer" value="3" />
      <input name="lacunarity" type="float" value="2.0" />
      <input name="diminish" type="float" value="0.55" />
      <input name="amplitude" type="float" value="0.1" />
    </fractal2d>
    <add name="grain_factor" type="float">
      <input name="in1" type="float" nodename="grain_noise" />
      <input name="in2" type="float" value="1.0" />
    </add>
    <multiply name="rock_color_grained" type="color3">
      <input name="in1" type="color3" nodename="rock_color" />
      <input name="in2" type="float" nodename="grain_factor" />
    </multiply>
    <multiply name="matrix_color_grained" type="color3">
      <input name="in1" type="color3" value="0.40, 0.39, 0.38" />
      <input name="in2" type="float" nodename="grain_factor" />
    </multiply>
    <mix name="final_color" type="color3">
      <input name="bg" type="color3" nodename="matrix_color_grained" />
      <input name="fg" type="color3" nodename="rock_color_grained" />
      <input name="mix" type="float" nodename="rock_mask" />
    </mix>
    <output name="out" type="color3" nodename="final_color" />
  </nodegraph>
  <nodegraph name="road_normal_graph">
    <texcoord name="texcoord1" type="vector2" />
    <separate2 name="uv_components" type="vector2">
      <input name="in" type="vector2" nodename="texcoord1" />
    </separate2>
    <multiply name="tiled_u" type="float">
      <input name="in1" type="float" nodename="uv_components" output="outx" />
      <input name="in2" type="float" value="9.0" />
    </multiply>
    <multiply name="tiled_v" type="float">
      <input name="in1" type="float" nodename="uv_components" output="outy" />
      <input name="in2" type="float" value="9.0" />
    </multiply>
    <combine2 name="tiled_uv" type="vector2">
      <input name="in1" type="float" nodename="tiled_u" />
      <input name="in2" type="float" nodename="tiled_v" />
    </combine2>
    <worleynoise2d name="cell_edges" type="float">
      <input name="texcoord" type="vector2" nodename="tiled_uv" />
      <input name="jitter" type="float" value="0.95" />
      <input name="style" type="integer" value="2" />
    </worleynoise2d>
    <smoothstep name="rock_mask" type="float">
      <input name="in" type="float" nodename="cell_edges" />
      <input name="low" type="float" value="0.04" />
      <input name="high" type="float" value="0.14" />
    </smoothstep>
    <heighttonormal name="tangent_normal" type="vector3">
      <input name="in" type="float" nodename="rock_mask" />
      <input name="scale" type="float" value="0.5" />
      <input name="texcoord" type="vector2" nodename="texcoord1" />
    </heighttonormal>
    <normalmap name="world_normal" type="vector3">
      <input name="in" type="vector3" nodename="tangent_normal" />
      <input name="scale" type="float" value="1.0" />
    </normalmap>
    <output name="out" type="vector3" nodename="world_normal" />
  </nodegraph>
  <standard_surface name="SR_road_aggregate" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="road_color_graph" output="out" />
    <input name="specular" type="float" value="0.3" />
    <input name="specular_roughness" type="float" value="0.78" />
    <input name="metalness" type="float" value="0.0" />
    <input name="coat" type="float" value="0.0" />
    <input name="normal" type="vector3" nodegraph="road_normal_graph" output="out" />
  </standard_surface>
  <surfacematerial name="M_road_aggregate" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_road_aggregate" />
  </surfacematerial>
</materialx>

<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_checkerboard_normal">
    <texcoord name="uv0" type="vector2" />
    <checkerboard name="checker" type="color3" nodedef="ND_checkerboard_color3">
      <input name="color1" type="color3" value="0.0, 0.0, 0.0" />
      <input name="color2" type="color3" value="1.0, 1.0, 1.0" />
      <input name="uvtiling" type="vector2" value="4.0, 4.0" />
      <input name="texcoord" type="vector2" nodename="uv0" />
    </checkerboard>
    <separate3 name="checker_channels" type="color3">
      <input name="in" type="color3" nodename="checker" />
    </separate3>
    <heighttonormal name="checker_tangent_normal" type="vector3">
      <input name="in" type="float" nodename="checker_channels" output="outx" />
      <input name="scale" type="float" value="1.0" />
      <input name="texcoord" type="vector2" nodename="uv0" />
    </heighttonormal>
    <normalmap name="checker_world_normal" type="vector3">
      <input name="in" type="vector3" nodename="checker_tangent_normal" />
      <input name="scale" type="float" value="1.0" />
    </normalmap>
    <output name="out" type="vector3" nodename="checker_world_normal" />
  </nodegraph>
  <standard_surface name="SR_checkerboard_normal" type="surfaceshader">
    <input name="base_color" type="color3" value="0.42, 0.48, 0.58" />
    <input name="specular" type="float" value="0.9" />
    <input name="specular_roughness" type="float" value="0.22" />
    <input name="metalness" type="float" value="0.0" />
    <input name="normal" type="vector3" nodegraph="NG_checkerboard_normal" output="out" />
  </standard_surface>
  <surfacematerial name="M_checkerboard_normal" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_checkerboard_normal" />
  </surfacematerial>
</materialx>

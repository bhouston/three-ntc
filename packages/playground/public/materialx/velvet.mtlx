<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <standard_surface name="SR_velvet" type="surfaceshader">
    <input name="base" type="float" value="1.0" />
    <input name="base_color" type="color3" output="base_color_out" nodegraph="velvet_graph" />
    <input name="specular" type="float" output="specular_out" nodegraph="velvet_graph" />
    <input name="specular_color" type="color3" output="base_color_out" nodegraph="velvet_graph" />
    <input name="specular_roughness" type="float" output="roughness_out" nodegraph="velvet_graph" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="sheen" type="float" output="sheen_out" nodegraph="velvet_graph" />
    <input name="sheen_color" type="color3" value="0.25, 0.3, 0.55" />
    <input name="sheen_roughness" type="float" value="0.3" />
  </standard_surface>
  <surfacematerial name="Velvet" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_velvet" />
  </surfacematerial>
  <nodegraph name="velvet_graph">
    <texcoord name="texcoord1" type="vector2" />
    <place2d name="crown_uv_flip" type="vector2">
      <input name="texcoord" type="vector2" nodename="texcoord1" />
      <input name="pivot" type="vector2" value="0.5, 0.5" />
      <input name="scale" type="vector2" value="1.0, -1.0" />
    </place2d>
    <image name="crown_tex" type="color3">
      <input name="file" type="filename" value="../textures/crown.png" colorspace="srgb_texture" />
      <input name="default" type="color3" value="0.15, 0.12, 0.35" />
      <input name="texcoord" type="vector2" nodename="crown_uv_flip" />
    </image>

    <!-- luminance drives roughness (gold stitching = smooth, navy velvet = rough) -->
    <luminance name="crown_luminance" type="color3">
      <input name="in" type="color3" nodename="crown_tex" />
    </luminance>
    <separate3 name="luminance_channels" type="color3">
      <input name="in" type="color3" nodename="crown_luminance" />
    </separate3>
    <range name="roughness_range" type="float">
      <input name="in" type="float" nodename="luminance_channels" output="outr" />
      <input name="inlow" type="float" value="0.3" />
      <input name="inhigh" type="float" value="0.7" />
      <input name="outlow" type="float" value="0.85" />
      <input name="outhigh" type="float" value="0.12" />
      <input name="doclamp" type="boolean" value="true" />
    </range>

    <!-- luminance also drives specular weight: navy velvet is fully matte (zero specular), only the bright gold thread picks up a highlight -->
    <range name="specular_range" type="float">
      <input name="in" type="float" nodename="luminance_channels" output="outr" />
      <input name="inlow" type="float" value="0.3" />
      <input name="inhigh" type="float" value="0.7" />
      <input name="outlow" type="float" value="0.0" />
      <input name="outhigh" type="float" value="0.35" />
      <input name="doclamp" type="boolean" value="true" />
    </range>

    <!-- "blueness" = how much the pixel reads as navy background rather than gold thread -->
    <separate3 name="crown_channels" type="color3">
      <input name="in" type="color3" nodename="crown_tex" />
    </separate3>
    <max name="gold_channel_max" type="float">
      <input name="in1" type="float" nodename="crown_channels" output="outr" />
      <input name="in2" type="float" nodename="crown_channels" output="outg" />
    </max>
    <subtract name="blueness" type="float">
      <input name="in1" type="float" nodename="crown_channels" output="outb" />
      <input name="in2" type="float" nodename="gold_channel_max" />
    </subtract>
    <range name="sheen_range" type="float">
      <input name="in" type="float" nodename="blueness" />
      <input name="inlow" type="float" value="-0.4" />
      <input name="inhigh" type="float" value="0.2" />
      <input name="outlow" type="float" value="0.1" />
      <input name="outhigh" type="float" value="1.0" />
      <input name="doclamp" type="boolean" value="true" />
    </range>

    <output name="base_color_out" type="color3" nodename="crown_tex" />
    <output name="roughness_out" type="float" nodename="roughness_range" />
    <output name="specular_out" type="float" nodename="specular_range" />
    <output name="sheen_out" type="float" nodename="sheen_range" />
  </nodegraph>
</materialx>

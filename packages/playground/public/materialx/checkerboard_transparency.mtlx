<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <nodegraph name="NG_checkerboard">
    <texcoord name="uv0" type="vector2" />
    <checkerboard name="checker" type="color3" nodedef="ND_checkerboard_color3">
      <input name="color1" type="color3" value="0.0, 0.0, 0.0" />
      <input name="color2" type="color3" value="1.0, 1.0, 1.0" />
      <input name="uvtiling" type="vector2" value="4.0, 4.0" />
      <input name="texcoord" type="vector2" nodename="uv0" />
    </checkerboard>
    <output name="out" type="color3" nodename="checker" />
  </nodegraph>
  <nodegraph name="alpha_wave_graph">
    <texcoord name="texcoord1" type="vector2" />
    <separate2 name="uv_components" type="vector2">
      <input name="in" type="vector2" nodename="texcoord1" />
    </separate2>
    <multiply name="u_phase" type="float">
      <input name="in1" type="float" nodename="uv_components" output="outx" />
      <input name="in2" type="float" value="12.566371" />
    </multiply>
    <multiply name="v_phase" type="float">
      <input name="in1" type="float" nodename="uv_components" output="outy" />
      <input name="in2" type="float" value="6.283185" />
    </multiply>
    <add name="phase" type="float">
      <input name="in1" type="float" nodename="u_phase" />
      <input name="in2" type="float" nodename="v_phase" />
    </add>
    <sin name="sin_wave" type="float">
      <input name="in" type="float" nodename="phase" />
    </sin>
    <multiply name="scaled_wave" type="float">
      <input name="in1" type="float" nodename="sin_wave" />
      <input name="in2" type="float" value="0.5" />
    </multiply>
    <add name="alpha_out" type="float">
      <input name="in1" type="float" nodename="scaled_wave" />
      <input name="in2" type="float" value="0.5" />
    </add>
    <output name="out" type="float" nodename="alpha_out" />
  </nodegraph>
  <gltf_pbr name="SR_checkerboard_transparency" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_checkerboard" output="out" />
    <input name="metallic" type="float" value="0.0" />
    <input name="roughness" type="float" value="0.22" />
    <input name="alpha" type="float" output="out" nodegraph="alpha_wave_graph" />
    <input name="alpha_mode" type="integer" value="2" />
  </gltf_pbr>
  <surfacematerial name="M_checkerboard_transparency" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_checkerboard_transparency" />
  </surfacematerial>
</materialx>
